{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Fast Test Run (2 Epochs, CPU)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode", "all",
                "--cpu",
                "--epochs", "2",
                "--fs_epochs", "1"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Full Pipeline (Train + Evaluate)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode", "all"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Evaluation Only",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode", "eval"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
